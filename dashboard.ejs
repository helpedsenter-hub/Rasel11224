<%- include("partials/header",{title:"Dashboard | Shopping BD"}) %><h1>Hello, <%= user.name %></h1><p><%= user.email %></p><div class="stats"><div class="stat"><b><%= referralCount %></b><span>Registered referrals</span></div><div class="stat"><b>৳<%= Number(totalCommission).toFixed(2) %></b><span>Sales-based referral commission</span></div></div><section class="formcard wide"><h2>Your referral link</h2><p>Share this link. A referral reward is recorded only if the referred customer's order is verified as completed.</p><input readonly value="<%= (typeof publicUrl!=='undefined' && publicUrl ? publicUrl : '') %>/register?ref=<%= user.referral_code %>" onclick="this.select()"><p><strong>Referral code:</strong> <%= user.referral_code %></p></section><h2>Your orders</h2><div class="tablewrap"><table><tr><th>Order</th><th>Product</th><th>Total</th><th>Status</th></tr><% if(orders.length){orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.product_name %></td><td>৳<%= Number(o.total).toFixed(2) %></td><td><%= o.status %></td></tr><% })}else{ %><tr><td colspan="4">No orders yet.</td></tr><% } %></table></div><h2>Referral commission history</h2><div class="tablewrap"><table><tr><th>Order</th><th>Product</th><th>Commission</th><th>Status</th></tr><% if(commissions.length){commissions.forEach(c=>{ %><tr><td>#<%= c.order_id %></td><td><%= c.product_name %></td><td>৳<%= Number(c.amount).toFixed(2) %></td><td><%= c.status %></td></tr><% })}else{ %><tr><td colspan="4">No eligible sales commission yet.</td></tr><% } %></table></div><%- include("partials/footer") %>