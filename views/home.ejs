<%- include("partials/header",{title:"Shopping BD | Shop"}) %><section class="hero"><p class="eyebrow">SHOPPING BD</p><h1>Discover products. Shop with confidence.</h1><p>Browse products and place an order. Referral rewards, where offered, are linked only to verified completed sales.</p><a class="button" href="/register">Create account</a></section><h2>Available products</h2><div class="products"><% if(products.length){ products.forEach(p=>{ %><article class="product"><% if(p.image_url){ %><img src="<%= p.image_url %>" alt="<%= p.name %>"><% }else{ %><div class="placeholder">Product image</div><% } %><div class="pad"><h3><%= p.name %></h3><p><%= p.description %></p><strong>৳<%= Number(p.price).toFixed(2) %></strong><% if(user){ %><form method="post" action="/checkout" class="buy"><input type="hidden" name="productId" value="<%= p.id %>"><input name="name" placeholder="Customer name" required><input name="phone" placeholder="Phone number" required><textarea name="address" placeholder="Delivery address" required></textarea><select name="paymentMethod"><option value="cash_on_delivery">Cash on delivery</option><option value="bkash_manual">bKash (manual confirmation)</option><option value="nagad_manual">Nagad (manual confirmation)</option></select><button>Place order</button></form><% }else{ %><p><a class="button" href="/login">Login to order</a></p><% } %></div></article><% })}else{ %><p>Products will appear here once added by the admin.</p><% } %></div><%- include("partials/footer") %>
