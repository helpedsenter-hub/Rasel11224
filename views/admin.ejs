<%- include("partials/header",{title:"Admin | Shopping BD"}) %><h1>Shopping BD Admin</h1><p>Referral rate currently configured: <strong><%= commissionPercent %>%</strong> of eligible completed order value. Check local legal and tax requirements before enabling rewards.</p><section class="formcard wide"><h2>Add product</h2><form method="post" action="/admin/products"><label>Product name<input name="name" required></label><label>Description<textarea name="description"></textarea></label><label>Price (BDT)<input type="number" min="0" step="0.01" name="price" required></label><label>Image URL<input type="url" name="image_url"></label><button>Add product</button></form></section><h2>Products</h2><div class="tablewrap"><table><tr><th>Product</th><th>Price</th><th>Action</th></tr><% products.forEach(p=>{ %><tr><td><%= p.name %> <%= p.active?"":"(hidden)" %></td><td>৳<%= Number(p.price).toFixed(2) %></td><td><% if(p.active){ %><form method="post" action="/admin/products/<%= p.id %>/hide"><button class="danger">Hide</button></form><% } %></td></tr><% }) %></table></div><h2>Orders</h2><div class="tablewrap"><table><tr><th>Order</th><th>Customer</th><th>Product</th><th>Total</th><th>Status</th><th>Update</th></tr><% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.customer_name %><br><small><%= o.email %></small></td><td><%= o.product_name %></td><td>৳<%= Number(o.total).toFixed(2) %></td><td><%= o.status %></td><td><form method="post" action="/admin/orders/<%= o.id %>/status"><select name="status"><% ["pending","processing","shipped","completed","cancelled"].forEach(s=>{ %><option <%= o.status===s?"selected":"" %>><%= s %></option><% }) %></select><button>Save</button></form></td></tr><% }) %></table></div><h2>Recent users</h2><div class="tablewrap"><table><tr><th>Name</th><th>Email</th><th>Referral code</th><th>Role</th></tr><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.referral_code %></td><td><%= u.role %></td></tr><% }) %></table></div><%- include("partials/footer") %>
